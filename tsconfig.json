{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": true,

    /* Bundled projects */
    "lib": ["dom", "dom.iterable", "ES2023", "WebWorker"],
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "types": ["@cloudflare/workers-types", "vite/client", "vinext/types"],
    "incremental": true,

    /* Path Aliases */
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "eslint.config.mjs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.cjs",
    "**/*.js",
    "worker/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "dist",
    ".wrangler",
    "src/tests",
    "src/**/*.test.ts",
    "src/dummies",
    "test",
    "tests",
    "playwright.config.ts",
    "vitest.config.ts",
    ".e2e-state"
  ]
}
