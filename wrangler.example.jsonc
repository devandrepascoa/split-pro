{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitpro",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "routes": [{ "pattern": "split.example.com", "custom_domain": true }],
  "workers_dev": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "issues": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitpro",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "splitpro-uploads" }],
  "send_email": [{ "name": "EMAIL" }],
  "workflows": [
    {
      "name": "splitpro-scheduler",
      "binding": "SCHEDULER",
      "class_name": "SchedulerWorkflow",
      // Every minute: run due recurring expenses, send recurrence notifications,
      // and (on CLEAR_CACHE_CRON_RULE) clean up cached bank data and currency rates.
      "schedules": ["* * * * *"],
    },
  ],
  "vars": {
    "NEXTAUTH_URL": "https://split.example.com",
    "DEFAULT_HOMEPAGE": "/balances",
    "ENABLE_SENDING_INVITES": "true",
    "DISABLE_EMAIL_SIGNUP": "true",
    "INVITE_ONLY": "false",
    "PREVIEW_ACCESS_AUTH": "false",
    "FROM_EMAIL": "splitpro@example.com",
    "CLEAR_CACHE_CRON_RULE": "0 2 * * 0",
    "CACHE_RETENTION_INTERVAL": "2 days",
    "CURRENCY_RATE_PROVIDER": "frankfurter",
    "UPLOAD_MAX_FILE_SIZE_MB": "10",
  },
  "previews": {
    "vars": {
      "NEXTAUTH_URL": "https://replace-with-this-preview-url",
      "NEXTAUTH_SECRET": "preview-only-secret-change-at-runtime",
      "NODE_ENV": "production",
      "DEFAULT_HOMEPAGE": "/balances",
      "ENABLE_SENDING_INVITES": "false",
      "DISABLE_EMAIL_SIGNUP": "true",
      "INVITE_ONLY": "true",
      "PREVIEW_ACCESS_AUTH": "true",
      "PREVIEW_ACCESS_AUD": "replace-with-your-access-audience-tag",
      "CLEAR_CACHE_CRON_RULE": "0 2 * * 0",
      "CACHE_RETENTION_INTERVAL": "2 days",
      "CURRENCY_RATE_PROVIDER": "frankfurter",
      "UPLOAD_MAX_FILE_SIZE_MB": "10",
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "splitpro-preview",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations",
      },
    ],
    "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "splitpro-preview-uploads" }],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
      "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
    },
  },
}
