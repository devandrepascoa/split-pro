{
  // Used only by the Vitest integration project (@cloudflare/vitest-pool-workers).
  "name": "splitpro-test",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitpro-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "splitpro-test-uploads" },
    { "binding": "BACKUPS", "bucket_name": "splitpro-test-backups" },
  ],
  "vars": {
    "SKIP_ENV_VALIDATION": "1",
    "NEXTAUTH_URL": "http://localhost:8787",
    "NEXTAUTH_SECRET": "test-secret-test-secret-test-secret-123456",
  },
}
